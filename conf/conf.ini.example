# ============================================================
# 配置模板：复制成 conf.ini 后再填写实际环境信息
#   Windows:  copy conf\conf.ini.example conf\conf.ini
#   Linux  :  cp conf/conf.ini.example conf/conf.ini
#
# conf.ini 属于「本地环境配置」，.gitignore 里已声明不入库（里面会放数据库口令、
# Jenkins 账号等凭据），所以每个新环境 clone 之后都要自己复制一份。
# 本模板只保留占位符，禁止把真实口令写进来。
# ============================================================

# 被测系统地址（电子商务项目 flask mock 服务）。
# 本地启动：
#   cd <apiFlaskService 目录>
#   .venv\Scripts\python.exe base\flask_service.py      （监听 127.0.0.1:8787）
[api_envi]
host = http://127.0.0.1:8787

# 业务前置登录账号（conftest.py 的 login_first 夹具使用）。
# 必须与 testcase/login/login.yaml 中「登录成功」用例的账号保持一致，
# 否则前置登录失败，接口关联用的 token 就写不进 extract.yaml，
# 新增用户等用例会在 ${get_extract_data(token)} 这一步直接报错。
#
# 这里填的是 mock 服务的固定测试账号，不算敏感信息：
#   1) 账号密码写死在被测服务源码里（base/flask_service.py -> user_login() 的 user_info）；
#   2) testcase/login/login.yaml 里同样写着 admin123。
# 之所以在模板里给可用的默认值，是为了让 CI 从干净 clone 直接能跑起来
#（Jenkins 每次克隆到自己的工作区，conf.ini 不入库，模板就是它的初始配置）。
# 换成真实环境时记得把这里改成环境自己的账号，并用别的方式注入口令。
[LOGIN]
username = test01
password = admin123

# 数据库断言（common/connection.py + assertions.py 的 db 断言）用。
# 电商项目是 flask mock 服务，数据在 data/mockdata/*.json 里，没有数据库，
# 当前用例没有用 db 断言；以后接 MySQL 时把 type 改成 mysql 即可，断言写法不用动
# （两种连接的 query() 都返回 list[dict]）。
[DB]
type = sqlite
# SQLite 文件路径，相对 auto-test 项目根目录；断言以只读方式打开（避免测试代码误改数据）
sqlite_path = ../GreaterWMS/db.sqlite3

# MySQL 连接参数（[DB] type = mysql 时才用）
[MYSQL]
host = 127.0.0.1
port = 3306
username = change_me
password = change_me
database = change_me

# 自动化测试数据清理（common/clean_data.py，由 conftest.py 的 clean_history_data 夹具调用）。
# 注意：这段的规则是按原 WMS 项目写的（按 creater 前缀删 ASN 入库单、还原库位标记），
# 换成别的被测系统时先保持 enable = 0（关闭），改好 common/clean_data.py 再打开。
[CLEAN]
# 1=开启会话前自动清理，0=关闭
enable = 0
# 测试数据标识前缀
creater_prefix = api_auto
# 1=会话前把 Normal 库位重新标记为空库位（WMS 专用，其它项目留 0）
reset_bin_label = 0

# Redis（common/connection.py 的 RedisClient 用），不需要可以留空
[REDIS]
host = 127.0.0.1
port = 6379
username =
password =
db = 0
# 集群模式才需要，格式 host1:port1,host2:port2,...；留空则走单机模式
startup_nodes =

# Jenkins 通知用（conftest.py 收尾时用 common/operJenkins.py 取构建报告链接，
# 再通过 common/feishu.py 推送）。没接 Jenkins 时这里填不通也不会影响用例执行，
# 只是收尾时会等 timeout 秒后跳过通知。
[JENKINS]
url = http://127.0.0.1:8080/
username = change_me
password = change_me
timeout = 30
job_name = change_me

# 飞书通知（conftest.py 收尾时推送测试结果）
[FEISHU]
# 自定义机器人 Webhook：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
webhook =
# 签名校验密钥：机器人没开"签名校验"就留空；
# 开了但填错，飞书会返回 sign match fail（错误码 19021）
secret =
# 自定义关键词：机器人开了「自定义关键词」安全设置时必填（填其中一个词即可）。
# 不填的话飞书返回 19024 Key Words Not Found —— 消息里不包含该关键词
keyword =
